# Copied to /etc/movie-streamer.env by install.sh — edit, then: systemctl restart movie-streamer

# Folder (inside the LXC) that holds your movies
MEDIA_ROOT=/media

# Where to push. tiangolo/nginx-rtmp uses the "live" application on port 1935.
# The last part ("movie") is the stream key; VLC plays the same URL.
RTMP_URL=rtmp://YOUR_VPS_IP/live/movie

# jellyfin-ffmpeg (installed by install.sh)
FFMPEG=/usr/lib/jellyfin-ffmpeg/ffmpeg
FFPROBE=/usr/lib/jellyfin-ffmpeg/ffprobe

# GPU profile:
#   vaapi     = Intel (decode, tone-map, scale and encode all on the GPU)
#   vaapi-amd = AMD (VA-API; HDR tone-mapping on the CPU)
#   nvenc     = NVIDIA (CUDA/NVENC)
#   x264      = no GPU (CPU only, slow)
ENCODER=vaapi
# Intel/AMD: the GPU's render node (ls -l /dev/dri/by-path on the host shows which is which)
VAAPI_DEVICE=/dev/dri/renderD128
# NVIDIA: GPU index (nvidia-smi -L)
CUDA_DEVICE=0

# Defaults shown in the UI
VIDEO_BITRATE=6M
MAX_HEIGHT=1080
AUDIO_BITRATE=192k

# Web UI
PORT=8080
# Set a password to require a login (user name below)
APP_USER=admin
APP_PASSWORD=
